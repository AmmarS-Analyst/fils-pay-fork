# Copy to ops/.env.prod (ops/deploy.sh does this for you), then edit the first
# block. The secrets block is filled in automatically on the first deploy.
# ops/.env.prod is gitignored: never commit it.

# --- where the site lives ---------------------------------------------------
# Public URL of the merchant dashboard + checkout + API (no trailing slash).
PUBLIC_URL=https://shop.example.com
# What Caddy listens on. With a real domain, point DNS at this server and keep
# these two; Caddy gets and renews the TLS certificate by itself.
SITE_ADDRESS=shop.example.com
ADMIN_ADDRESS=shop.example.com:8443
# Email for the certificate account (expiry notices).
ACME_EMAIL=you@example.com

# Plain-HTTP smoke test with no domain (browsers will NOT keep the session
# cookie unless COOKIE_SECURE=false):
#   PUBLIC_URL=http://SERVER_IP
#   SITE_ADDRESS=:80
#   ADMIN_ADDRESS=:8443
#   COOKIE_SECURE=false

# --- behaviour ---------------------------------------------------------------
# true: the login response includes the one-time code, because there is no
# email/SMS provider in this project (see docs/DEPLOY.md, "OTP").
OTP_DEV_EXPOSE=true
COOKIE_SECURE=true

# --- secrets (generated by deploy.sh when empty) ------------------------------
POSTGRES_PASSWORD=
SETTLEMENT_INTERNAL_TOKEN=
ACQUIRER_CALLBACK_SIGNING_SECRET=
WEBHOOK_SECRET_ENCRYPTION_KEY=
