# Image for apps/api, apps/reporting and the migrate/seed jobs. The services
# run TypeScript through tsx (see each `command:` in docker-compose.yml).
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps ./apps
COPY db ./db
COPY scripts ./scripts
RUN npm ci --no-audit --no-fund

# Run as the unprivileged "node" user. /data/kyc is where the API stores KYC
# uploads; mount a volume there (docker-compose.prod.yml does).
RUN mkdir -p /data/kyc && chown -R node:node /data
USER node
