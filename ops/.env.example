# Copy to ops/.env (gitignored) and fill in. docker compose reads it for the
# ${...} values in docker-compose.yml. Never commit real values.
SETTLEMENT_INTERNAL_TOKEN=
ACQUIRER_CALLBACK_SIGNING_SECRET=
WEBHOOK_SECRET_ENCRYPTION_KEY=

# Browser origins allowed to call the API with cookies (comma separated).
# Defaults to the local dashboards (localhost:5173 and :5174). Set this to the
# real dashboard/admin URLs when hosting.
CORS_ORIGINS=
